{
  "FunctionInvoke": "download-weather-data",
  "WorkflowName": "noaa-ghcnd-corvallis-weather",
  "DefaultDataStore": "S3",
  "LoggingDataStore": "S3",
  "FaaSrLog": "FaaSrLog",
  "InvocationIDFromDate": "%Y-%m-%d-%H-%M-%S",
  "ActionList": {
    "download-weather-data": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "download_weather_data",
      "Arguments": {
        "folder": "workflow_data",
        "output1": "corvallis_current_year_weather.csv",
        "output2": "corvallis_10year_avg_weather.csv"
      },
      "InvokeNext": [
        "plot-precipitation",
        "plot-max-temperature",
        "plot-min-temperature"
      ]
    },
    "plot-precipitation": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "plot_precipitation",
      "Arguments": {
        "folder": "workflow_data",
        "input1": "corvallis_current_year_weather.csv",
        "input2": "corvallis_10year_avg_weather.csv",
        "output1": "corvallis_precipitation_comparison.png"
      },
      "InvokeNext": []
    },
    "plot-max-temperature": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "plot_max_temperature",
      "Arguments": {
        "folder": "workflow_data",
        "input1": "corvallis_current_year_weather.csv",
        "input2": "corvallis_10year_avg_weather.csv",
        "output1": "corvallis_tmax_comparison.png"
      },
      "InvokeNext": []
    },
    "plot-min-temperature": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "plot_min_temperature",
      "Arguments": {
        "folder": "workflow_data",
        "input1": "corvallis_current_year_weather.csv",
        "input2": "corvallis_10year_avg_weather.csv",
        "output1": "corvallis_tmin_comparison.png"
      },
      "InvokeNext": []
    }
  },
  "ActionContainers": {
    "download-weather-data": "ghcr.io/faasr/github-actions-python:latest",
    "plot-precipitation": "ghcr.io/faasr/github-actions-python:latest",
    "plot-max-temperature": "ghcr.io/faasr/github-actions-python:latest",
    "plot-min-temperature": "ghcr.io/faasr/github-actions-python:latest"
  },
  "ComputeServers": {
    "GH": {
      "FaaSType": "GitHubActions",
      "UserName": "renatof",
      "ActionRepoName": "FaaSr-CURATE",
      "Branch": "main",
      "UseSecretStore": true
    }
  },
  "DataStores": {
    "S3": {
      "Endpoint": "https://s3.amazonaws.com",
      "Bucket": "faasr-bucket-0005",
      "Region": "us-east-1",
      "AccessKey": "S3_AccessKey",
      "SecretKey": "S3_SecretKey",
      "Writable": "TRUE"
    }
  },
  "FunctionGitRepo": {
    "download_weather_data": "renatof/FaaSr-CURATE/main/functions/download_weather_data.py",
    "plot_precipitation": "renatof/FaaSr-CURATE/main/functions/plot_precipitation.py",
    "plot_max_temperature": "renatof/FaaSr-CURATE/main/functions/plot_max_temperature.py",
    "plot_min_temperature": "renatof/FaaSr-CURATE/main/functions/plot_min_temperature.py"
  },
  "PyPIPackageDownloads": {
    "download_weather_data": [
      "requests",
      "pandas"
    ],
    "plot_precipitation": [
      "pandas",
      "matplotlib"
    ],
    "plot_max_temperature": [
      "pandas",
      "matplotlib"
    ],
    "plot_min_temperature": [
      "pandas",
      "matplotlib"
    ]
  },
  "Secrets": [
    "NOAA_API_TOKEN"
  ]
}