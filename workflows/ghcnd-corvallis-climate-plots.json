{
  "FunctionInvoke": "download-ghcnd-data",
  "WorkflowName": "ghcnd-corvallis-climate-plots",
  "DefaultDataStore": "S3",
  "LoggingDataStore": "S3",
  "FaaSrLog": "FaaSrLog",
  "InvocationIDFromDate": "%Y-%m-%d-%H-%M-%S",
  "ActionList": {
    "download-ghcnd-data": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "download_ghcnd_data",
      "Arguments": {
        "folder": "workflow_data",
        "output1": "corvallis_current_year.csv",
        "output2": "corvallis_10yr_average.csv"
      },
      "InvokeNext": [
        "generate-climate-plot(3)",
        "fit-tmax-regression"
      ]
    },
    "generate-climate-plot": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "generate_climate_plot",
      "Arguments": {
        "folder": "workflow_data",
        "input1": "corvallis_current_year.csv",
        "input2": "corvallis_10yr_average.csv",
        "output1": "corvallis_climate_plot_{rank}.png"
      },
      "InvokeNext": []
    },
    "fit-tmax-regression": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "fit_tmax_regression",
      "Arguments": {
        "folder": "workflow_data",
        "input1": "corvallis_current_year.csv",
        "output1": "corvallis_tmax_regression.csv",
        "output2": "corvallis_tmax_regression_summary.csv"
      },
      "InvokeNext": [
        "plot-tmax-regression"
      ]
    },
    "plot-tmax-regression": {
      "FaaSServer": "GH",
      "Type": "Python",
      "FunctionName": "plot_tmax_regression",
      "Arguments": {
        "folder": "workflow_data",
        "input1": "corvallis_current_year.csv",
        "input2": "corvallis_tmax_regression.csv",
        "input3": "corvallis_tmax_regression_summary.csv",
        "output1": "corvallis_tmax_regression_plot.png"
      },
      "InvokeNext": []
    }
  },
  "ActionContainers": {
    "download-ghcnd-data": "ghcr.io/faasr/github-actions-python:latest",
    "generate-climate-plot": "ghcr.io/faasr/github-actions-python:latest",
    "fit-tmax-regression": "ghcr.io/faasr/github-actions-python:latest",
    "plot-tmax-regression": "ghcr.io/faasr/github-actions-python:latest"
  },
  "ComputeServers": {
    "GH": {
      "FaaSType": "GitHubActions",
      "UserName": "renatof",
      "ActionRepoName": "FaaSr-CURATE",
      "Branch": "main",
      "UseSecretStore": true
    }
  },
  "DataStores": {
    "S3": {
      "Endpoint": "https://s3.amazonaws.com",
      "Bucket": "faasr-bucket-0005",
      "Region": "us-east-1",
      "AccessKey": "S3_AccessKey",
      "SecretKey": "S3_SecretKey",
      "Writable": "TRUE"
    }
  },
  "FunctionGitRepo": {
    "download_ghcnd_data": "renatof/FaaSr-CURATE/main/functions/download_ghcnd_data.py",
    "generate_climate_plot": "renatof/FaaSr-CURATE/main/functions/generate_climate_plot.py",
    "fit_tmax_regression": "renatof/FaaSr-CURATE/main/functions/fit_tmax_regression.py",
    "plot_tmax_regression": "renatof/FaaSr-CURATE/main/functions/plot_tmax_regression.py"
  },
  "PyPIPackageDownloads": {
    "download_ghcnd_data": [
      "meteostat",
      "pandas",
      "requests"
    ],
    "generate_climate_plot": [
      "pandas",
      "matplotlib"
    ],
    "fit_tmax_regression": [
      "pandas",
      "scipy"
    ],
    "plot_tmax_regression": [
      "pandas",
      "matplotlib"
    ]
  },
  "Secrets": [
    "NOAA_CDO_TOKEN"
  ]
}